{
  "name": "bomberman-arena",
  "version": "1.0.0",
  "description": "Bomberman Arena — Jeu multijoueur en temps réel",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "start:server": "npm run start --workspace=@bomberman-arena/server",
    "start:client": "npm run start --workspace=@bomberman-arena/client",
    "dev:server": "npm run dev --workspace=@bomberman-arena/server",
    "test": "jest --passWithNoTests",
    "test:server": "jest --passWithNoTests --projects packages/server",
    "lint": "eslint 'packages/*/src/**/*.ts'",
    "format": "prettier --write 'packages/*/src/**/*.ts'",
    "typecheck": "tsc -b packages/shared packages/server packages/client",
    "clean": "rm -rf packages/*/dist"
  },
  "dependencies": {
    "ws": "^8.14.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.7",
    "@types/ws": "^8.5.8",
    "@types/uuid": "^9.0.5",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "electron": "^27.0.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.5",
    "eslint": "^8.52.0",
    "prettier": "^3.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moreau-Simon/BOMBERMAN-ARENA.git"
  },
  "author": "",
  "license": "ISC"
}
